#define F_CPU 16000000UL  // 16 MHz clock speed
#include <avr/io.h>
#include <util/delay.h>

// Initialize UART for 9600 baud
void USART_Init(unsigned int ubrr) {
    // Set baud rate
    UBRR0H = (unsigned char)(ubrr >> 8);
    UBRR0L = (unsigned char)ubrr;

    // Enable transmitter
    UCSR0B = (1 << TXEN0);

    // Set frame format: 8 data, 1 stop bit
    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

// Transmit a single character
void USART_Transmit(unsigned char data) {
    // Wait until buffer is empty
    while (!(UCSR0A & (1 << UDRE0)));
    // Send data
    UDR0 = data;
}

// Transmit string
void USART_SendString(const char* str) {
    while (*str) {
        USART_Transmit(*str++);
    }
}

// Initialize ADC
void ADC_Init() {
    ADMUX = (1 << REFS0); // AVcc with external capacitor at AREF pin, ADC0 selected
    ADCSRA = (1 << ADEN)  // Enable ADC
           | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0); // Prescaler 128
}

// Read ADC from channel 0 (ADC0 / PC0)
uint16_t ADC_Read() {
    ADCSRA |= (1 << ADSC); // Start conversion
    while (ADCSRA & (1 << ADSC)); // Wait until done
    return ADC;
}

// Convert integer to string (simple)
void itoa(uint16_t val, char* str) {
    uint16_t i = 0;
    char temp[6];
    do {
        temp[i++] = (val % 10) + '0';
        val /= 10;
    } while (val > 0);
    for (uint16_t j = 0; j < i; j++) {
        str[j] = temp[i - j - 1];
    }
    str[i] = '\0';
}

int main(void) {
    char buffer[10];
    USART_Init(103); // 9600 baud @ 16 MHz (UBRR = 103)
    ADC_Init();

    USART_SendString("MQ-135 Air Quality Sensor Ready\r\n");

    while (1) {
        uint16_t adc_value = ADC_Read();
        itoa(adc_value, buffer);

        USART_SendString("ADC Value: ");
        USART_SendString(buffer);
        USART_SendString("\r\n");

        _delay_ms(1000); // 1 second delay
    }
}
